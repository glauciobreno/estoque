# Banco: em desenvolvimento use um arquivo local; em produção, a URL do Turso
TURSO_DATABASE_URL=file:local.db
# Só necessário com o Turso (libsql://...). Nunca commitar o valor real.
TURSO_AUTH_TOKEN=

JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Origens do front, separadas por vírgula, sem '*' (a API recusa curinga).
CORS_ORIGIN=http://localhost:5173
PORT=3000

# Frontend (Vite). Em desenvolvimento deixe vazio: o Vite encaminha /api para a API.
# Em produção, a URL pública da API (defina na Vercel, não neste arquivo).
# VITE_API_URL=https://api.exemplo.com
# API_PROXY_TARGET=http://localhost:3000

# Cookie de sessão. Com front e API em domínios diferentes use COOKIE_SAMESITE=none (exige HTTPS)
COOKIE_SAMESITE=lax

# Usado só por `npm run db:seed -w @estoque/api` para criar o primeiro administrador
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=troque-esta-senha

# Segurança e observabilidade da API
# Atrás de proxy/CDN (Vercel, Render...) use true para o limite de requisições enxergar o IP real.
# Em produção (variáveis no painel da Vercel): TRUST_PROXY=true, NODE_ENV=production e CORS_ORIGIN com a URL do site.
TRUST_PROXY=false
LOG_LEVEL=info
# Requisições por minuto e por IP: geral e só para o login
RATE_LIMIT_MAX=300
RATE_LIMIT_LOGIN_MAX=10
